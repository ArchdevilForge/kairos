# Kairos human-controlled futures alert config
#
# Default profile: price-velocity Telegram alerts only (human opens chart).
# CoinGlass is optional enrichment (market-cap weight, scanner RSI); enable
# longShortRatio / liquidation / resonance in alertPolicy if you want them back.
#
# Usage:
#   1. Copy this file to your Kairos config path.
#   2. Export TELEGRAM_BOT_TOKEN and TELEGRAM_CHAT_ID.
#   3. Run `go run ./cmd/kairosd` (or built binary) for realtime alerts.
#   4. Run `go run ./cmd/kairos-alert` from cron/systemd timer for scanner summaries.

exchange: "okx"
defaultTimeframe: "1d"
notificationTimezone: "Asia/Shanghai"

# dataManager: legacy name for kairos-watch runtime (WS feeds, dedup, cooldown).
# Delivery gates live under alertPolicy.
telegram:
  enabled: true
  parseMode: "HTML"

dataManager:
  exchanges:
    - "okx"
  topSymbols: 30
  refreshIntervalHours: 4
  dedupWindowSeconds: 5
  symbolCooldownMinutes: 45

alertPolicy:
  enabled: true
  allowedEventTypes:
    - "price_velocity"
    - "market_impulse"
    - "market_trend"
    - "market_stress"
    - "market_decay"
  minSeverity: "LOW"
  minPriceChangePct: 0.9
  minVolumeRatio: 6.0
  minOpenInterestChangePct: 5.0
  minFundingRateAbs: 0.0005
  minFundingRateChangeAbs: 0.0003
  liquidityWeight:
    enabled: true
    minWeight: 0.5
    # BTC/ETH always weight 1.0; other symbols scaled by CoinGlass market cap at subscribe.
    majorSymbols:
      - "BTC/USDT:USDT"
      - "ETH/USDT:USDT"

priceVelocity:
  enabled: true
  windows:
    - seconds: 60
      threshold: 0.9
    - seconds: 120
      threshold: 1.4
  cooldownSeconds: 120

volumeSpike:
  enabled: false
  multiplier: 3.0
  windowMinutes: 10
  minHistorySeconds: 600
  minNotifyInterval: "2m"

futuresMetrics:
  enabled: false
  pollIntervalSeconds: 300
  fetchFundingPerSymbol: true
  openInterest:
    enabled: false
    minChangePct: 5.0
    minNotifyInterval: "30m"
  fundingRate:
    enabled: false
    absRateThreshold: 0.0005
    minChangeAbs: 0.0003
    minNotifyInterval: "30m"

longShortRatio:
  enabled: false
  pollIntervalSeconds: 300
  absThreshold: 80.0
  zscoreThreshold: 2.5
  zscoreWindow: 48
  velocityThresholdPct: 15.0
  minNotifyInterval: "30m"

liquidation:
  enabled: false
  pollIntervalSeconds: 300
  absThresholdUsd: 1000000
  zscoreThreshold: 2.5
  zscoreWindow: 48
  imbalanceThreshold: 0.80
  minNotifyInterval: "30m"

resonanceScorer:
  enabled: false
  windowSeconds: 300
  minDimensions: 2
  minScore: 55
  cooldownSeconds: 600

scanner:
  intervalSeconds: 300
  universeSize: 30
  candidateLimit: 20
  deepAnalysisLimit: 10
  totalTimeoutSeconds: 75
  exchangeRequestTimeoutSeconds: 8
  symbolAnalysisTimeoutSeconds: 12
  timeframes:
    - "1d"
    - "4h"
    - "15m"
  generateChartsByDefault: false

exchanges:
  primary: "okx"
  backups: []
  rateLimit: true
  canonicalQuote: "USDT"
  settle: "USDT"

scoring:
  candidateWeights:
    quoteVolume: 4.0
    priceVelocity: 2.0
    openInterest: 1.0
    funding: 1.0
    relativeStrength: 2.0
    btcRelativeStrength: 1.5
    rsiHotness: 1.0
  setupWeights:
    dailyTrend: 1.5
    structure: 2.0
    entryTrigger: 2.0
    btcResonance: 1.0
    marketCycle: 1.0
    volumeConfirmation: 1.0
    riskReward: 1.5
  cycleThresholds:
    spring: 5.5
    summer: 5.5
    autumn: 6.5
    winter: 7.5
  minimumLiquidityQuoteVolume: 30000000.0
  minimumRiskReward: 1.8
  strictRiskReward: 2.2
  shortThresholdPremium: 0.5
  cycleDetector:
    springBtcChangeMin: 10.0
    summerBtcChangeMin: 30.0
    autumnBtcChangeMax: 50.0
    winterBtcChangeMax: -10.0
    highVolatilityThreshold: 5.0
    lowVolatilityThreshold: 2.0
    highFundingThreshold: 0.05
    lowFundingThreshold: -0.01

risk:
  maxPositionPct:
    major: 33.0
    altcoin: 33.0
  maxLeverage:
    major: 10.0
    altcoin: 5.0
  weakCyclePositionMultiplier: 0.5
  shortPositionMultiplier: 0.75
  inverseCyclePositionMultiplier: 0.5

storage:
  databasePath: "~/.local/share/kairos/kairos.db"
  retentionDays: 90
  jsonlExport: false
  jsonlPath: ""
  watchHintRetentionHours: 24
  watchHintScoreBoost: 0.5

# CoinGlass (optional: market-cap weight at subscribe, scanner RSI hotness):
# Clone https://github.com/ArchdevilForge/coinglass-decrypt as ../coinglass-decrypt
# or set KAIROS_COINGLASS_DECRYPT=/path/to/coinglass-decrypt
# Prefer Python decrypt (handles rotating v=0/1/2 keys):
#   KAIROS_COINGLASS_USE_PYTHON=1
#   KAIROS_COINGLASS_PYTHON=/path/to/coinglass-decrypt/.venv/bin/python
# KAIROS_COINGLASS_USE_PYTHON=0 forces native Go decrypt (legacy v only)

# MarketPulse: cross-sectional market state detector.
# Defaults stay disabled; set enabled=true and shadowMode=false to send Telegram.
# Quiet-market single-coin gate is independent (gateIndividualAlertsWhenQuiet).
marketPulse:
  enabled: false
  shadowMode: true
  snapshotIntervalSeconds: 5
  freshnessSeconds: 30
  maxLookupGapSeconds: 15
  warmupSeconds: 300
  historyRetentionSeconds: 900
  minFreshRatio: 0.80
  minValidSymbols: 15
  noiseReturnPct: 0.08
  primarySymbols:
    - "BTC/USDT:USDT"
    - "ETH/USDT:USDT"
  requirePrimaryConfirmation: true
  volatility:
    # Z is computed for logs/events; hard gate off until calibrated on live tape.
    enabled: false
    ewmaAlpha: 0.10
    floorPct: 0.03
  impulse:
    windowSeconds: 60
    minBreadth: 0.65
    minMedianReturnPct: 0.18
    minMedianZ: 1.5
    confirmationSamples: 3
    confirmationWindowSamples: 4
  trend:
    windowSeconds: 300
    minBreadth: 0.60
    minMedianReturnPct: 0.45
    minPersistSeconds: 180
    confirmationSamples: 5
    confirmationWindowSamples: 6
  stress:
    windowSeconds: 60
    minBreadth: 0.80
    minMedianReturnPct: 0.35
    minMedianZ: 2.5
  decay:
    enabled: true
    maxBreadth: 0.50
    maxMedianReturnPct: 0.08
    persistSeconds: 60
    notify: false
    quietResetSeconds: 60
  leaders:
    limit: 5
  cooldownSeconds: 600
  stressCooldownSeconds: 300
  gateIndividualAlertsWhenQuiet: false
  allowIsolatedExtremeWhenQuiet: false
  isolatedExtremeMinZ: 4.0

charts:
  defaultChartCount: 1
  outputPath: "~/.local/share/kairos/charts"
  cleanupDays: 7
  multiTimeframeScoreThreshold: 8.0
