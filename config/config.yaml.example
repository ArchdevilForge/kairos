# Kairos human-controlled futures alert config
#
# Default profile: price-velocity Telegram alerts only (human opens chart).
# CoinGlass is optional enrichment (market-cap weight, scanner RSI); enable
# longShortRatio / liquidation / resonance in alertPolicy if you want them back.
#
# Usage:
#   1. Copy this file to your Kairos config path.
#   2. Export TELEGRAM_BOT_TOKEN and TELEGRAM_CHAT_ID.
#   3. Optional DingTalk mirror: DINGTALK_WEBHOOK_URL + DINGTALK_SECRET, dingTalk.enabled=true.
#   4. Run `go run ./cmd/kairosd` (or built binary) for realtime MarketPulse / price alerts.
#   5. Optional: after a market alert, run `kairos-alert --dry-run` for a scanner
#      explanation of leaders (not a scheduled trade-signal product).
#   6. Calibrate: `go run ./cmd/kairos-calibrate --config ...` → lift_5m vs random.

# Exchange authorities:
#   exchanges.primary     — scanner / MarketPulse / provenance authority
#   dataManager.exchanges — realtime adapter set (primary must be included)
# (The old top-level `exchange` key still works as a legacy alias.)

telegram:
  enabled: true

# DingTalk custom-robot webhook (mirror of gated alerts). Secrets via env only.
# DINGTALK_WEBHOOK_URL=https://oapi.dingtalk.com/robot/send?access_token=...
# DINGTALK_SECRET=SECxxx   # recommended: robot security = 加签
dingTalk:
  enabled: false

# dataManager: kairosd realtime runtime (WS feeds, dedup, cooldown).
# Delivery gates live under alertPolicy. dedupWindowSeconds rate-limits
# attempts per event key; symbolCooldownMinutes commits per symbol only after
# a successful delivery. refreshIntervalHours re-discovers the Top-N universe
# and resubscribes the WS feeds.
dataManager:
  exchanges:
    - "okx"
  topSymbols: 30
  refreshIntervalHours: 4
  dedupWindowSeconds: 5
  symbolCooldownMinutes: 45

alertPolicy:
  enabled: true
  # Note: enabling resonanceScorer requires "resonance" in this list
  # (validated at startup — resonance alerts are delivered through the same
  # policy gate as every other event type).
  allowedEventTypes:
    - "price_velocity"
    - "resonance"
    - "market_impulse"
    - "market_trend"
    - "market_stress"
    - "market_decay"
  minSeverity: "LOW"
  minPriceChangePct: 0.9
  minVolumeRatio: 6.0
  minOpenInterestChangePct: 5.0
  minFundingRateAbs: 0.0005
  minFundingRateChangeAbs: 0.0003
  liquidityWeight:
    enabled: true
    minWeight: 0.5
    # BTC/ETH always weight 1.0; other symbols scaled by CoinGlass market cap at subscribe.
    majorSymbols:
      - "BTC/USDT:USDT"
      - "ETH/USDT:USDT"

priceVelocity:
  enabled: true
  windows:
    - seconds: 60
      threshold: 0.9
    - seconds: 120
      threshold: 1.4
  cooldownSeconds: 120

volumeSpike:
  enabled: false
  multiplier: 3.0
  windowMinutes: 10
  minHistorySeconds: 600
  minNotifyInterval: "2m"

futuresMetrics:
  enabled: false
  pollIntervalSeconds: 300
  openInterest:
    enabled: false
    minChangePct: 5.0
    minNotifyInterval: "30m"
  fundingRate:
    enabled: false
    absRateThreshold: 0.0005
    minChangeAbs: 0.0003
    minNotifyInterval: "30m"

longShortRatio:
  enabled: false
  pollIntervalSeconds: 300
  absThreshold: 80.0
  zscoreThreshold: 2.5
  zscoreWindow: 48
  velocityThresholdPct: 15.0
  minNotifyInterval: "30m"

liquidation:
  enabled: false
  pollIntervalSeconds: 300
  absThresholdUsd: 1000000
  zscoreThreshold: 2.5
  zscoreWindow: 48
  imbalanceThreshold: 0.80
  minNotifyInterval: "30m"

resonanceScorer:
  enabled: false
  windowSeconds: 300
  minDimensions: 2
  minScore: 55
  cooldownSeconds: 600

# scanner is one-shot and optional. Prefer running it manually after a
# MarketPulse alert (post-alert explanation). Do not cron it as the primary product.
scanner:
  universeSize: 30
  candidateLimit: 20
  deepAnalysisLimit: 10
  totalTimeoutSeconds: 75
  exchangeRequestTimeoutSeconds: 8
  symbolAnalysisTimeoutSeconds: 12
  timeframes:
    - "1d"
    - "4h"
    - "15m"
  generateChartsByDefault: false

exchanges:
  primary: "okx"
  backups: []

scoring:
  candidateWeights:
    quoteVolume: 4.0
    priceVelocity: 2.0
    openInterest: 1.0
    funding: 1.0
    relativeStrength: 2.0
    btcRelativeStrength: 1.5
    rsiHotness: 1.0
  setupWeights:
    dailyTrend: 1.5
    structure: 2.0
    entryTrigger: 2.0
    btcResonance: 1.0
    marketCycle: 1.0
    volumeConfirmation: 1.0
    riskReward: 1.5
  cycleThresholds:
    spring: 5.5
    summer: 5.5
    autumn: 6.5
    winter: 7.5
  minimumLiquidityQuoteVolume: 30000000.0
  minimumRiskReward: 1.8
  strictRiskReward: 2.2
  shortThresholdPremium: 0.5
  cycleDetector:
    springBtcChangeMin: 10.0
    summerBtcChangeMin: 30.0
    autumnBtcChangeMax: 50.0
    winterBtcChangeMax: -10.0
    highVolatilityThreshold: 5.0
    lowVolatilityThreshold: 2.0
    highFundingThreshold: 0.05
    lowFundingThreshold: -0.01

risk:
  maxPositionPct:
    major: 33.0
    altcoin: 33.0
  maxLeverage:
    major: 10.0
    altcoin: 5.0
  weakCyclePositionMultiplier: 0.5
  shortPositionMultiplier: 0.75
  inverseCyclePositionMultiplier: 0.5

# databasePath anchors the storage directory. Sidecar JSONL next to it:
#   market-pulse-events.jsonl / market-pulse-outcomes.jsonl /
#   market-pulse-snapshots.jsonl (60s cross-section for lift_5m baselines) /
#   watch hints.
storage:
  databasePath: "~/.local/share/kairos/kairos.db"
  watchHintRetentionHours: 24
  watchHintScoreBoost: 0.5

# CoinGlass (optional: market-cap weight at subscribe, scanner RSI hotness):
# Clone https://github.com/ArchdevilForge/coinglass-decrypt as ../coinglass-decrypt
# or set KAIROS_COINGLASS_DECRYPT=/path/to/coinglass-decrypt
# Prefer Python decrypt (handles rotating v=0/1/2 keys):
#   KAIROS_COINGLASS_USE_PYTHON=1
#   KAIROS_COINGLASS_PYTHON=/path/to/coinglass-decrypt/.venv/bin/python
# KAIROS_COINGLASS_USE_PYTHON=0 forces native Go decrypt (legacy v only)

# MarketPulse: cross-sectional market state detector (primary product).
# Defaults stay disabled; set enabled=true and shadowMode=false to send Telegram.
# When enabled, kairosd also appends ~60s snapshot rows for kairos-calibrate lift_5m.
# Quiet-market single-coin gate is independent (gateIndividualAlertsWhenQuiet).
marketPulse:
  enabled: false
  shadowMode: true
  snapshotIntervalSeconds: 5
  freshnessSeconds: 30
  maxLookupGapSeconds: 15
  warmupSeconds: 300
  historyRetentionSeconds: 900
  # 覆盖率底线，不是质量目标：快照本身只统计新鲜且已预热的币，每条告警都会
  # 附带自己的样本覆盖率。此值只用于识别"检测器基本瞎了"。
  # 旧值 0.80 会让少数几条行情断流演变成整整两天的静默。
  minFreshRatio: 0.60
  # 中位数/广度真正的统计要求。
  minValidSymbols: 15
  noiseReturnPct: 0.08
  # 数据不足持续多久后播报一次运维告警（0 = 关闭，不建议）。
  # 静默的检测器和平静的市场在界面上无法区分。
  dataHealthAlertSeconds: 900
  # 注意力预算：滚动 24 小时内最多几条大盘打扰（market_stress 不受限）。
  maxAlertsPerDay: 6
  primarySymbols:
    - "BTC/USDT:USDT"
    - "ETH/USDT:USDT"
  requirePrimaryConfirmation: true
  volatility:
    # Z is computed for logs/events; hard gate off until calibrated on live tape.
    enabled: false
    ewmaAlpha: 0.10
    floorPct: 0.03
  # Observation windows are fixed in code: impulse/stress 60s, trend 300s.
  # 阈值提高自 0.65/0.18：在旧阈值下 19 条生产告警里有 12 条的中位涨跌幅
  # 不足 0.25%，对加密永续而言属于噪声，是告警疲劳的主要来源。
  impulse:
    minBreadth: 0.75
    minMedianReturnPct: 0.35
    minMedianZ: 1.5
    confirmationSamples: 3
    confirmationWindowSamples: 4
  trend:
    minBreadth: 0.60
    minMedianReturnPct: 0.45
    minPersistSeconds: 180
    confirmationSamples: 5
    confirmationWindowSamples: 6
  stress:
    minBreadth: 0.80
    minMedianReturnPct: 0.35
    minMedianZ: 2.5
  decay:
    enabled: true
    maxBreadth: 0.50
    maxMedianReturnPct: 0.08
    persistSeconds: 60
    notify: false
    quietResetSeconds: 60
  leaders:
    limit: 5
  cooldownSeconds: 600
  stressCooldownSeconds: 900
  # Ignored while shadowMode=true (shadow must not change single-coin alerts).
  gateIndividualAlertsWhenQuiet: false

# Kairos emits chart specs only; rendering is a downstream concern.
charts:
  defaultChartCount: 1
  outputPath: "~/.local/share/kairos/charts"
  multiTimeframeScoreThreshold: 8.0

# Decision desk / OpportunitySession (off by default — fail closed).
# Shadow: sessions+rank board+journal; tickets only when enrich passes real gates.
# assumeSpreadOK: only for shadow without L2; production must leave false.
opportunity:
  enabled: false
  shadowMode: true
  maxTicketsPerSession: 3
  assumeSpreadOK: false
  outcomeMaxAgeHours: 6
  # Risk sizing (Canonical §9: numeric pct from config, not code constants).
  # riskBudgets values are % of equity at risk per template (0.75 = 0.75%).
  # maxLeverage caps the ticket risk plan (0 keeps the code fallback of 5).
  riskBudgets:
    alignedSpring: 0.75
    alignedSummer: 0.75
    alignedAutumn: 0.40
    counterTrend: 0.25
    mixedContext: 0.0
    noTrade: 0.0
  maxLeverage: 5
